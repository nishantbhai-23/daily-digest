# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
ENV/

# Output directory (generated rolling ledgers & summaries)
output/

# macOS system files
.DS_Store

# Local secrets — repo-specific provider API keys, never committed.
# See digest/core/env.py for the loader; .env.example shows the expected shape.
.env
.env.*
!.env.example

# Design documents — local-only, except HIGH_LEVEL_DESIGN.md which is
# committed as the one doc meant to be public/reviewed on GitHub.
docs/*
!docs/HIGH_LEVEL_DESIGN.md
